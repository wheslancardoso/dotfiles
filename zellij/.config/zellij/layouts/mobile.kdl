layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="Mobile Dev" focus=true {
        pane split_direction="vertical" {
            pane size="65%" name="Editor (LazyVim Mobile)" focus=true {
                command "nvim"
            }
            pane size="35%" split_direction="horizontal" {
                pane size="50%" name="Antigravity AI (agy)" {
                    command "bash"
                    args "-c" "if command -v agy &>/dev/null; then agy; else echo 'Antigravity CLI (agy) não encontrado no PATH.'; exec bash; fi"
                }
                pane size="50%" name="Metro Bundler / Flutter Logs"
            }
        }
    }
}
