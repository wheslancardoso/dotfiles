{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background/background.js"
   },
   "content_scripts": [ {
      "css": [ "content/content.css" ],
      "js": [ "content/content.js" ],
      "matches": [ "https://www.youtube.com/*" ]
   } ],
   "description": "Extract all YouTube video comments and replies with thread structure and export to JSON or CSV",
   "host_permissions": [ "https://www.youtube.com/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "YouTube Comments & Replies Extractor",
   "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "unlimitedStorage",
      "tabs"
   ],
   "version": "1.1.0"
}
