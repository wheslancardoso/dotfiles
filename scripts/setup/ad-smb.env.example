# ==============================================================================
# Exemplo de configuração parametrizada para Active Directory & SMB (AGR/Host)
# Copie para ~/.config/agr/ad-smb.env e preencha os valores reais.
# NUNCA commite credenciais reais no repositório!
# ==============================================================================

# --- Active Directory ---
AD_DOMAIN="<empresa.local>"
AD_DC_IP="<10.x.x.x>"
AD_JOIN_USER="<Administrator>"

# --- Compartilhamento SMB/CIFS (ex: servidor de deploy AGR ou pasta do host Windows) ---
SMB_SHARE="//<10.6.63.18>/<Sistemas_TI>"
SMB_MOUNT_POINT="$HOME/mnt/sistemas_ti"
SMB_DOMAIN="<AGR>"
SMB_CREDENTIALS_FILE="$HOME/.smbcredentials"
SMB_VERSION="3.0"

# Opcional: preencher apenas em arquivo local fora do Git ou passar via variável de ambiente
# SMB_USERNAME="<seu-usuario>"
# SMB_PASSWORD="<sua-senha>"
