# Cursor inteligente: Beam (|) no insert mode, Block (█) no normal mode
function zle-keymap-select() {
    if [ "$KEYMAP" = "vicmd" ]; then
        echo -ne "\e[2 q" # Block
    else
        echo -ne "\e[6 q" # Beam
    fi
}
zle -N zle-keymap-select
echo -ne "\e[6 q" # Inicia com beam

# Histórico Substring Search com setas ou j/k no vicmd
bindkey '^[[A' zsh-history-substring-search-up 2>/dev/null || true
bindkey '^[[B' zsh-history-substring-search-down 2>/dev/null || true
bindkey -M vicmd 'k' zsh-history-substring-search-up 2>/dev/null || true
bindkey -M vicmd 'j' zsh-history-substring-search-down 2>/dev/null || true

