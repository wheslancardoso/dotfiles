# 📋 clip: Tubulação direta pro Clipboard do Hyprland (ex: cat arquivo | clip ou clip "texto")
clip() {
    if [ ! -t 0 ]; then
        if command -v wl-copy &>/dev/null; then
            wl-copy
        elif command -v xclip &>/dev/null; then
            xclip -selection clipboard
        fi
    elif [ $# -gt 0 ]; then
        if command -v wl-copy &>/dev/null; then
            echo -n "$*" | wl-copy
        elif command -v xclip &>/dev/null; then
            echo -n "$*" | xclip -selection clipboard
        fi
    else
        echo "Uso: comando | clip   OU   clip \"texto a copiar\""
    fi
}

# 📱 qr: Gerador Instantâneo de QR Code no terminal (celular -> PC sem cabos nem login)
qr() {
    local text=""
    if [ ! -t 0 ]; then
        text="$(cat)"
    elif [ $# -gt 0 ]; then
        text="$*"
    else
        if command -v wl-paste &>/dev/null; then
            text="$(wl-paste)"
        elif command -v xclip &>/dev/null; then
            text="$(xclip -selection clipboard -o)"
        fi
    fi

    if [ -z "$text" ]; then
        echo "Uso: qr <texto/url>  OU  comando | qr  OU  apenas 'qr' (lê do clipboard)"
        return 1
    fi

    if command -v qrencode &>/dev/null; then
        echo ""
        qrencode -t ANSIUTF8 "$text"
        echo ""
        echo "📱 Aponte a câmera do celular para escanear"
    else
        echo "Instalando qrencode..."
        sudo pacman -S --noconfirm qrencode 2>/dev/null && qrencode -t ANSIUTF8 "$text"
    fi
}



# Yazi CWD Wrapper: navegue no terminal com 'y' ou 'yz' e mude de pasta automaticamente ao sair com 'q'
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
alias yz='y'

# 🎯 Yazi File Chooser Widget (Ctrl + Y ou Alt + Y no Prompt do Terminal)
# Abre o Yazi para escolher arquivos visualmente e injeta os caminhos no comando atual
function yazi-picker-widget() {
    local tmp="$(mktemp -t "yazi-chooser.XXXXXX")"
    yazi --chooser-file="$tmp"
    if [ -f "$tmp" ]; then
        local files
        files="$(tr '\n' ' ' < "$tmp" | sed 's/ $//')"
        if [ -n "$files" ]; then
            LBUFFER="${LBUFFER}${files} "
        fi
        rm -f "$tmp"
    fi
    zle redisplay
}
