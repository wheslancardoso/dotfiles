# --- FZF God-Mode & Catppuccin Mocha Previews ---
if command -v fzf &> /dev/null; then
    export FZF_DEFAULT_OPTS="--height 45% --layout=reverse --border --inline-info \
        --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
        --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
        --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
    
    if command -v fd &> /dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'
    fi

    export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {} 2>/dev/null || cat {}' --bind 'ctrl-/:change-preview-window(down|hidden|)'"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} 2>/dev/null | head -150'"
fi

# --- Funções Interativas do FZF (Terminal God-Mode) ---
# 1. fif: Find In Files (Ripgrep + FZF + Bat Preview + abre no Neovim na linha exata)
fif() {
    if [ ! "$#" -gt 0 ]; then echo "Uso: fif <termo_busca>"; return 1; fi
    local match
    match="$(rg --column --line-number --no-heading --color=always --smart-case "$*" 2>/dev/null | \
        fzf --ansi \
            --delimiter : \
            --preview 'bat --style=numbers --color=always --highlight-line {2} {1} 2>/dev/null' \
            --preview-window '+{2}-/2' | cut -d: -f1,2)"
    if [ -n "$match" ]; then
        local file line
        file="$(echo "$match" | cut -d: -f1)"
        line="$(echo "$match" | cut -d: -f2)"
        nvim "+$line" "$file"
    fi
}

# 2. fkill: Matador de Processos Interativo
fkill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf -m --header='[fkill] Selecione processos com TAB/Espaço e aperte ENTER' | awk '{print $2}')
    if [ -n "$pid" ]; then
        echo "$pid" | xargs kill -${1:-9}
        echo "✔ Processo(s) finalizado(s)."
    fi
}

# 3. fport: Inspecionar portas abertas e processos donos
fport() {
    ss -tulpn | fzf --header='[fport] Portas em escuta (LISTEN)'
}

# 4. fgit: Explorador interativo de commits do Git com Delta preview
fgit() {
    git log --graph --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" | \
    fzf --ansi --no-sort --reverse --tiebreak=index \
        --preview 'git show --color=always $(echo {} | grep -o "[a-f0-9]\{7\}" | head -1) | delta 2>/dev/null || git show $(echo {} | grep -o "[a-f0-9]\{7\}" | head -1)' \
        --header='[fgit] Navegador de Commits'
}

# 5. fcd: Pular para diretórios recentes/frequentes com preview
fcd() {
    local dir
    dir=$(zoxide query -l | fzf --preview 'eza --tree --color=always {} 2>/dev/null | head -100' --header='[fcd] Ir para diretório')
    [ -n "$dir" ] && cd "$dir"
}

