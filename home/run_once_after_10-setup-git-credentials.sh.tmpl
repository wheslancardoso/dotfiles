#!/bin/bash
# Hook pós-aplicação do Chezmoi: Garante credenciais Git seguras sem pedir senha

CREDENTIALS_FILE="$HOME/.git-credentials"

# Se já existe e não está vazio, apenas reforça as permissões estritas
if [ -s "$CREDENTIALS_FILE" ]; then
    chmod 600 "$CREDENTIALS_FILE"
    echo "✔ [Git] Credenciais já configuradas em $CREDENTIALS_FILE (permissões 600 confirmadas)."
    exit 0
fi

echo "ℹ [Git] Configurando autenticação automática do GitHub..."

TOKEN=""

# 1. Tentar obter via Bitwarden CLI (bw) se estiver instalado e desbloqueado
if command -v bw &>/dev/null; then
    BW_STATUS=$(bw status 2>/dev/null | grep '"status":' | tr -d '",: ' | cut -d's' -f2)
    if [ "$BW_STATUS" = "unlocked" ]; then
        echo "ℹ [Bitwarden] Cofre desbloqueado. Buscando token do GitHub..."
        TOKEN=$(bw get password "github" 2>/dev/null || bw get password "github.com" 2>/dev/null || bw get item "github" --raw 2>/dev/null | grep -oP 'ghp_[a-zA-Z0-9]+' | head -n 1)
        if [ -n "$TOKEN" ]; then
            echo "✔ [Bitwarden] Token do GitHub recuperado com sucesso!"
        fi
    fi
fi

# 2. Se não recuperou via Bitwarden e o terminal for interativo, solicita ao usuário
if [ -z "$TOKEN" ] && [ -t 0 ]; then
    echo ""
    echo "=================================================================="
    echo " [Git Setup] Token de Acesso do GitHub (PAT)"
    echo " Cole seu token para que o git push/pull nunca mais solicite senha."
    echo " Dica: Você pode pular pressionando [ENTER] e configurar depois."
    echo "=================================================================="
    read -r -s -p "Token GitHub (ghp_...): " INPUT_TOKEN
    echo ""
    if [ -n "$INPUT_TOKEN" ]; then
        TOKEN="$INPUT_TOKEN"
    fi
fi

# 3. Gravar credencial caso tenhamos o token
if [ -n "$TOKEN" ]; then
    echo "https://wheslancardoso:${TOKEN}@github.com" > "$CREDENTIALS_FILE"
    chmod 600 "$CREDENTIALS_FILE"
    git config --global credential.helper store
    echo "✔ [Git] Token armazenado com sucesso em $CREDENTIALS_FILE com permissões 600."
else
    echo "ℹ [Git] Nenhum token configurado no momento. As credenciais serão salvas na primeira vez que você rodar git push."
fi
