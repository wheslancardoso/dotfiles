[Unit]
Description=Google Drive 5TB (Rclone VFS On-Demand Virtual Mount)
Documentation=man:rclone(1) https://rclone.org/commands/rclone_mount/
After=network-online.target
Wants=network-online.target
AssertPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/gdrive
ExecStart=/usr/bin/rclone mount gdrive: %h/gdrive \
    --vfs-cache-mode full \
    --vfs-cache-max-size 50G \
    --vfs-cache-max-age 24h \
    --vfs-read-chunk-size 32M \
    --vfs-read-chunk-size-limit 2G \
    --buffer-size 64M \
    --dir-cache-time 72h \
    --poll-interval 15s \
    --attr-timeout 1s \
    --drive-pacer-min-sleep 10ms \
    --drive-pacer-burst 200 \
    --umask 022 \
    --rc \
    --rc-no-auth \
    --rc-addr 127.0.0.1:5572
ExecStop=/usr/bin/fusermount3 -u -z %h/gdrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
