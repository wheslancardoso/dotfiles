/* Rofi Config for Google Search) */

@import "~/.config/rofi/config.rasi"  

/* ---- Window ---- */
window {
	width: 40%;
	height: inherit;
    y-offset: 10px;
    location: north;
    children: [ "entry", "message" ];
    border: 2px;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.12);
}

/* ---- Entry ---- */ 
entry {
	expand: true;
	placeholder: "   Pesquisar no Google...";
	horizontal-align: 0.5;
	padding: 15px;
	border-radius: inherit;
}
