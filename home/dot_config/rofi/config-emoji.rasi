/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Apex Emoji Engine - Sovereign Vim & Catppuccin Glassmorphism */

/* ---- Global Configuration Fonts & Colors ---- */
@import "~/.config/rofi/0-shared-fonts.rasi"
@import "~/.config/rofi/wallust/colors-rofi.rasi"

* {
    selected: @color12;
}

/*****----- Configuration (Vim Navigation & Category Hotkeys) -----*****/
configuration {
    kb-remove-to-eol:           "";
    kb-remove-to-sol:           "";
    kb-remove-char-forward:     "Delete";
    kb-element-next:            "";
    kb-element-prev:            "";
    kb-row-up:                  "Up,Control+k,Control+p,ISO_Left_Tab,BackTab";
    kb-row-down:                "Down,Control+j,Control+n,Tab";
    kb-page-prev:               "Page_Up,Control+u";
    kb-page-next:               "Page_Down,Control+d";
    kb-accept-entry:            "Return,KP_Enter";
    kb-cancel:                  "Escape,Control+bracketleft";
    
    /* Category Hotkeys: Alt+1 to Alt+0 */
    kb-custom-1:                "Alt+1";
    kb-custom-2:                "Alt+2";
    kb-custom-3:                "Alt+3";
    kb-custom-4:                "Alt+4";
    kb-custom-5:                "Alt+5";
    kb-custom-6:                "Alt+6";
    kb-custom-7:                "Alt+7";
    kb-custom-8:                "Alt+8";
    kb-custom-9:                "Alt+9";
    kb-custom-10:               "Alt+0";
    
    /* Vim Yank: Ctrl+y */
    kb-custom-11:               "Control+y";
    
    /* Reset Filter: Alt+BackSpace */
    kb-custom-12:               "Alt+BackSpace";

    hover-select:               false;
    scroll-method:              0;
}

/*****----- Main Window (Frosted Glass) -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       55%;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px;
    border-radius:               18px;
    border-color:                rgba(255, 255, 255, 0.12);
    cursor:                      "default";
    background-color:            rgba(24, 24, 37, 0.92);
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     18px;
    border:                      0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     10px 14px;
    border:                      1px solid;
    border-radius:               12px;
    border-color:                rgba(255, 255, 255, 0.08);
    background-color:            rgba(49, 50, 68, 0.45);
    text-color:                  #cdd6f4;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    padding:                     4px 6px 4px 2px;
    expand:                      false;
    str:                         "󰞅";
    text-color:                  @selected;
    background-color:            transparent;
}

entry {
    enabled:                     true;
    padding:                     4px 0px;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    cursor:                      text;
    placeholder:                 "Buscar emoji em PT-BR (ex: joinha, fogo, cafe) | [Alt+1..0] Categorias | Ctrl+j/k Vim...";
    placeholder-color:           #6c7086;
}

/*****----- Message (Category Tabs Bar) -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     6px 12px;
    border:                      0px;
    border-radius:               8px;
    background-color:            rgba(49, 50, 68, 0.35);
    text-color:                  #a6adc8;
}

textbox {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    markup:                      true;
}

/*****----- Listview (Telescope / Vim Flow) -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     4px;
    margin:                      0px;
    padding:                     4px 0px;
    border:                      0px;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     8px 14px;
    border:                      0px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  #cdd6f4;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  #11111b;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element-text selected {
    text-color:                  #11111b;
}
