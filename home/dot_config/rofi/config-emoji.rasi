/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Apex Emoji Engine - Catppuccin Mocha Glassmorphic Style */

@import "~/.config/rofi/config.rasi" 

/* ---- Mainbox ---- */
mainbox {
  padding: 20px;
  spacing: 12px;
  children: [ "inputbar", "message", "listview" ];
}

/* ---- Window (Spacious & Frosted Glass) ---- */
window {
  width: 58%;
  border: 2px;
  border-radius: 18px;
  border-color: rgba(255, 255, 255, 0.12);
  background-color: rgba(24, 24, 37, 0.88);
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: "Buscar emoji em PT-BR (ex: joinha, fogo, cafe, coracao, choro) ou Alt+1..9...";
  placeholder-color: #6c7086;
  horizontal-align: 0.0;
}

/* ---- Listview (1 Coluna Ampla - Zero Cortes de Texto) ---- */
listview {
  columns: 1;
  lines: 9;
  fixed-height: true;
  scrollbar: true;
  spacing: 4px;
  padding: 4px 0px;
  cycle: true;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
  padding: 8px 14px;
  border-radius: 10px;
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  margin: 0px;
  padding: 0px;
}
