/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* KooL Hyprland Rofi Style 4 */
/* credit: https://github.com/adi1090x/rofi */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "  apps";
    display-run:                "  term";
    display-filebrowser:        "  files";
    display-window:             "  window";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
}

/* ---- Load wallust colors ---- */
@theme "~/.config/rofi/wallust/colors-rofi.rasi"

/*****----- Global Properties -----*****/
* {
    background-alt:              rgba(49, 50, 68, 0.55);
    selected:                    @color12;
    active:                      @color14;
    urgent:                      @color11;
    
    border-color:                rgba(255, 255, 255, 0.10);
    handle-color:                @selected;
    background-color:            transparent;
    foreground-color:            #cdd6f4;
    alternate-background:        transparent;
    normal-background:           transparent;
    normal-foreground:           #cdd6f4;
    urgent-background:           @urgent;
    urgent-foreground:           #11111b;
    active-background:           @active;
    active-foreground:           #11111b;
    selected-normal-background:  @selected;
    selected-normal-foreground:  #11111b;
    selected-urgent-background:  @urgent;
    selected-urgent-foreground:  #11111b;
    selected-active-background:  @active;
    selected-active-foreground:  #11111b;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #cdd6f4;
    alternate-urgent-background: @urgent;
    alternate-urgent-foreground: #11111b;
    alternate-active-background: @active;
    alternate-active-foreground: #11111b;
}


/*****----- Main Window (Glassmorphism & Frosted Blur) -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       44%;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px;
    border-radius:               16px;
    border-color:                rgba(255, 255, 255, 0.12);
    cursor:                      "default";
    background-color:            rgba(24, 24, 37, 0.86);
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     14px;
    margin:                      0px;
    padding:                     22px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "custombox" ];
}

/*****----- A Custom Box -----*****/
custombox {
    spacing:                     16px;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    orientation:                 horizontal;
    children:                    [ "mode-switcher", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     10px 14px;
    border:                      1px solid;
    border-radius:               12px;
    border-color:                rgba(255, 255, 255, 0.08);
    background-color:            rgba(49, 50, 68, 0.45);
    text-color:                  #cdd6f4;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-prompt-colon {
    enabled:                     true;
    padding:                     4px 6px 4px 2px;
    expand:                      false;
    str:                         "";
    background-color:            transparent;
    text-color:                  @selected;
}
entry {
    enabled:                     true;
    padding:                     4px 0px;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    cursor:                      text;
    placeholder:                 "Pesquisar...";
    placeholder-color:           #6c7086;
}
num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  #a6adc8;
}
textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    background-color:            inherit;
    text-color:                  #6c7086;
}
num-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  #a6adc8;
}
case-indicator {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}

/*****----- Listview (Sem bordas duras, estável sem encolher) -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     6px;
    margin:                      0px;
    padding:                     2px 0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    cursor:                      "default";
}
scrollbar {
    handle-width:                3px;
    handle-color:                @selected;
    border-radius:               10px;
    background-color:            rgba(49, 50, 68, 0.35);
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  #cdd6f4;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            transparent;
    text-color:                  #cdd6f4;
}
element normal.urgent {
    background-color:            @urgent-background;
    text-color:                  #11111b;
}
element normal.active {
    background-color:            transparent;
    text-color:                  @active;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  #11111b;
}
element selected.urgent {
    background-color:            @urgent;
    text-color:                  #11111b;
}
element selected.active {
    background-color:            @selected;
    text-color:                  #11111b;
}
element-text selected {
    text-color:                  #11111b;
}
element alternate.normal {
    background-color:            transparent;
    text-color:                  #cdd6f4;
}
element alternate.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}
element alternate.active {
    background-color:            transparent;
    text-color:                  @active;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Mode Switcher (Abas Laterais Refinadas) -----*****/
mode-switcher{
    enabled:                     true;
    expand:                      false;
    orientation:                 vertical;
    spacing:                     8px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  #cdd6f4;
}
button {
    padding:                     12px 18px;
    border:                      0px;
    border-radius:               10px;
    border-color:                transparent;
    background-color:            rgba(49, 50, 68, 0.40);
    text-color:                  #a6adc8;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      pointer;
}
button selected {
    border:                      0px;
    border-radius:               10px;
    border-color:                transparent;
    background-color:            @selected;
    text-color:                  #11111b;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                @border-color;
    background-color:            transparent;
    text-color:                  @foreground-color;
}
textbox {
    padding:                     10px 14px;
    border:                      1px;
    border-radius:               10px;
    border-color:                rgba(255, 255, 255, 0.08);
    background-color:            rgba(49, 50, 68, 0.45);
    text-color:                  #cdd6f4;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    highlight:                   none;
    placeholder-color:           #a6adc8;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     12px 16px;
    border:                      2px;
    border-radius:               12px;
    border-color:                @urgent;
    background-color:            rgba(30, 30, 46, 0.95);
    text-color:                  #cdd6f4;
}
