 /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  
 /* wallust template - colors-rofi */

* {
    /* Base Catppuccin Mocha */
    cat-base: rgba(30, 30, 46, 0.82);
    cat-mantle: rgba(24, 24, 37, 0.90);
    cat-crust: rgba(17, 17, 27, 0.95);
    cat-surface0: rgba(49, 50, 68, 0.55);
    cat-surface1: rgba(69, 71, 90, 0.70);
    cat-text: #cdd6f4;
    cat-subtext: #a6adc8;

    /* Wallust Dynamic Accents */
    accent-primary: #757679;
    accent-secondary: #B1B2B4;
    accent-active: #5F6063;
    accent-cyan: #858687;

    active-background: #757679;
    active-foreground: #11111b;
    normal-background: transparent;
    normal-foreground: #cdd6f4;
    urgent-background: #5F6063;
    urgent-foreground: #11111b;

    alternate-active-background: transparent;
    alternate-active-foreground: #757679;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #cdd6f4;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #5F6063;

    selected-active-background: #757679;
    selected-active-foreground: #11111b;
    selected-normal-background: #757679;
    selected-normal-foreground: #11111b;
    selected-urgent-background: #5F6063;
    selected-urgent-foreground: #11111b;

    background-color: transparent;
    background: @cat-base;
    background-alt: @cat-surface0;
    foreground: #cdd6f4;
    border-color: rgba(117,118,121, 0.35);

color0: #393A3B;
color1: #141619;
color2: #191A1D;
color3: #47484A;
color4: #58595B;
color5: #5A5B5D;
color6: #858687;
color7: #D0D0D1;
color8: #919292;
color9: #1B1E21;
color10: #212327;
color11: #5F6063;
color12: #757679;
color13: #78797C;
color14: #B1B2B4;
color15: #D0D0D1;


}

