 /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  
 /* wallust template - colors-rofi */

* {
    /* Base Catppuccin Mocha */
    cat-base: rgba(30, 30, 46, 0.82);
    cat-mantle: rgba(24, 24, 37, 0.90);
    cat-crust: rgba(17, 17, 27, 0.95);
    cat-surface0: rgba(49, 50, 68, 0.55);
    cat-surface1: rgba(69, 71, 90, 0.70);
    cat-text: #cdd6f4;
    cat-subtext: #a6adc8;

    /* Wallust Dynamic Accents */
    accent-primary: #6F7073;
    accent-secondary: #DADBDD;
    accent-active: #25282B;
    accent-cyan: #A4A4A6;

    active-background: #6F7073;
    active-foreground: #11111b;
    normal-background: transparent;
    normal-foreground: #cdd6f4;
    urgent-background: #25282B;
    urgent-foreground: #11111b;

    alternate-active-background: transparent;
    alternate-active-foreground: #6F7073;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #cdd6f4;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #25282B;

    selected-active-background: #6F7073;
    selected-active-foreground: #11111b;
    selected-normal-background: #6F7073;
    selected-normal-foreground: #11111b;
    selected-urgent-background: #25282B;
    selected-urgent-foreground: #11111b;

    background-color: transparent;
    background: @cat-base;
    background-alt: @cat-surface0;
    foreground: #cdd6f4;
    border-color: rgba(111,112,115, 0.35);

color0: #3A3A3B;
color1: #0B0E10;
color2: #181A1C;
color3: #1C1E20;
color4: #535456;
color5: #A0A1A3;
color6: #A4A4A6;
color7: #E4E5E6;
color8: #A0A0A1;
color9: #0F1316;
color10: #202326;
color11: #25282B;
color12: #6F7073;
color13: #D6D7D9;
color14: #DADBDD;
color15: #E4E5E6;


}

