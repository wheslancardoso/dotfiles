/* ---- Main Config - For Keybinds generation (SUPER + H) ---- */

@import "~/.config/rofi/config.rasi"  

configuration {
  matching: "normal";
  tokenize: true;
  normalize-match: true;
}  

/* ---- Window (Amplo e com Glassmorphism) ---- */
window {
  width: 70%;
  border: 2px;
  border-radius: 18px;
  border-color: rgba(255, 255, 255, 0.12);
  background-color: rgba(24, 24, 37, 0.88);
}

/* ---- Mainbox ---- */
mainbox {
  padding: 22px;
  spacing: 14px;
  children: [ "inputbar", "message", "listview" ];
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: "Buscar atalho, comando ou ferramenta (ex: yazi, som, devtype)...";
  placeholder-color: #6c7086;
}

/* ---- Listview (1 Coluna Larga - Leitura Limpa sem Cortes) ---- */
listview {
  columns: 1;
  lines: 11;
  fixed-height: false;
  scrollbar: true;
  spacing: 4px;
  padding: 6px 0px;
  border: 0px solid;
  cycle: true;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
  padding: 8px 14px;
  border-radius: 10px;
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  margin: 0px;
  padding: 0px;
}