# ==============================================================================
# ⚡ yt-dlp High-Speed Streaming & Download Configuration
# ==============================================================================
--concurrent-fragments 8
--buffer-size 16M
--retries 10
--fragment-retries 10
--no-check-certificates
--force-ipv4
--downloader-args "ffmpeg:-reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 5"
