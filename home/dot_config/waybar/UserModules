/* Waybar Modules Extras */

/* This is where you can add Extra Modules you wish. copy.sh will try to restore*/
/* this file along with the unique configs and styles. */
/* IMPORTANT, be mindful with , or ". else waybar will not start */

{
"custom/media_prev": {
    "format": "󰒮",
    "on-click": "$HOME/.config/hypr/scripts/MediaControl.sh --prev",
    "tooltip": true,
    "tooltip-format": "⏮️ Faixa Anterior"
},

"custom/media_play": {
    "format": "{icon}",
    "return-type": "json",
    "exec": "playerctl -a metadata --format '{\"alt\": \"{{status}}\", \"tooltip\": \"{{status}}: {{title}}\"}' -F 2>/dev/null",
    "format-icons": {
        "Playing": "󰏤",
        "Paused": "󰐊",
        "Stopped": "󰐊"
    },
    "on-click": "$HOME/.config/hypr/scripts/MediaControl.sh --play-pause",
    "tooltip": true
},

"custom/media_next": {
    "format": "󰒭",
    "on-click": "$HOME/.config/hypr/scripts/MediaControl.sh --next",
    "tooltip": true,
    "tooltip-format": "⏭️ Próxima Faixa"
}
}