{
  "mcpServers": {
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode"],
      "env": {
        "MAX_LOG_LINES": "40"
      }
    },
    "repomix": {
      "command": "npx",
      "args": ["-y", "repomix", "--mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "fast-playwright": {
      "command": "npx",
      "args": ["-y", "@tontoko/fast-playwright-mcp"],
      "env": {
        "INCLUDE_SNAPSHOT": "true",
        "INCLUDE_CONSOLE": "true",
        "NO_IMAGES": "true"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": ".gemini/memory.jsonl"
      }
    },
    "notebooklm": {
      "command": "npx",
      "args": ["-y", "notebooklm-mcp@latest"],
      "env": {
        "NOTEBOOKLM_BROWSER_CHANNEL": "chromium",
        "NOTEBOOK_URL": "https://notebooklm.google.com/notebook/955aecd5-fa95-4189-8ec9-623b7ff331dc",
        "NOTEBOOK_DESCRIPTION": "AGR System Technical Architecture and Domain Specifications Megadoc"
      }
    },
    "supabase": {
      "serverUrl": "https://mcp.supabase.com/mcp"
    }
  }
}
