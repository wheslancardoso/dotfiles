#!/usr/bin/env python3
# ==============================================================================
# BIBLIA CLI / ZEN READER & BIMODAL AUDIO (Linux / Hyprland)
# Consulta bíblica ultrarrápida (NVI), busca textual e narração neural (Edge-TTS).
# ==============================================================================

import os
import sys
import json
import re
import unicodedata
import argparse
import subprocess
import shutil

BIBLE_JSON_PATH = os.path.expanduser("~/.local/share/biblia/pt_nvi.json")
DOTFILES_BIBLE_PATH = os.path.expanduser("~/dotfiles/home/dot_local/share/biblia/pt_nvi.json")

# Cores ANSI para modo Zen no terminal
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
CYAN = "\033[36m"
YELLOW = "\033[33m"
GREEN = "\033[32m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
WHITE = "\033[97m"

def normalize(text: str) -> str:
    """Remove acentos, pontuação e converte para minúsculas."""
    text = unicodedata.normalize("NFKD", text)
    text = "".join(c for c in text if not unicodedata.combining(c))
    return re.sub(r"[^a-z0-9]", "", text.lower())

def load_bible():
    target = BIBLE_JSON_PATH if os.path.exists(BIBLE_JSON_PATH) else DOTFILES_BIBLE_PATH
    if not os.path.exists(target):
        sys.stderr.write(f"Erro: Arquivo bíblico não encontrado em {target}\n")
        sys.exit(1)
    with open(target, "r", encoding="utf-8") as f:
        return json.load(f)

