def find_book(bible, query: str):
    q_norm = normalize(query)
    # 1. Alias direto
    if q_norm in ALIASES:
        target_name = ALIASES[q_norm]
        for book in bible:
            if book["name"] == target_name:
                return book

    # 2. Match exato ou abreviação
    for book in bible:
        if normalize(book["abbrev"]) == q_norm or normalize(book["name"]) == q_norm:
            return book

    # 3. Prefixo / Substring
    for book in bible:
        if normalize(book["name"]).startswith(q_norm):
            return book

    return None

def wrap_text(text: str, width: int = 80, indent: str = "    ") -> str:
    words = text.split()
    lines = []
    current_line = []
    current_len = 0
    for w in words:
        if current_len + len(w) + 1 > width:
            lines.append(" ".join(current_line))
            current_line = [w]
            current_len = len(w)
        else:
            current_line.append(w)
            current_len += len(w) + 1
    if current_line:
        lines.append(" ".join(current_line))
    return "\n".join(lines[0:1] + [indent + line for line in lines[1:]])

def play_audio(title: str, text: str, rate: str = "+25%", voice: str = "pt-BR-AntonioNeural"):
    """Toca áudio neural via edge-tts e mpv em streaming."""
    subprocess.run(["notify-send", "-a", "Bíblia Zen", "-i", "audio-speakers", "-t", "3000",
                    f"🔊 Lendo: {title} ({rate})", "Pressione 'q' no terminal para pausar/sair."])
    
    edge_cmd = ["edge-tts", "--voice", voice, "--rate", rate, "--text", text]
    mpv_cmd = ["mpv", "--title=tts_stream_biblia", "--no-video", "--keep-open=no", "--really-quiet", "-"]
    
    try:
        p1 = subprocess.Popen(edge_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        p2 = subprocess.Popen(mpv_cmd, stdin=p1.stdout)
        p1.stdout.close()
        p2.communicate()
    except KeyboardInterrupt:
        p2.terminate()
        print("\n\033[33mLeitura pausada.\033[0m")

def show_chapter(bible, book, chapter_num: int, verse_range: str = None, listen: bool = False, rate: str = "+25%"):
    chapters = book["chapters"]
    if chapter_num < 1 or chapter_num > len(chapters):
        print(f"{YELLOW}Aviso: {book['name']} possui {len(chapters)} capítulos.{RESET}")
        return

    chapter_verses = chapters[chapter_num - 1]
    total_verses = len(chapter_verses)

    v_start, v_end = 1, total_verses
    if verse_range:
        if "-" in verse_range:
            parts = verse_range.split("-")
            v_start = int(parts[0])
            v_end = int(parts[1]) if parts[1] else total_verses
        else:
            v_start = int(verse_range)
            v_end = int(verse_range)

    # Cabeçalho Zen
    term_width = min(shutil.get_terminal_size((80, 20)).columns, 90)
    print("\n" + "─" * term_width)
    ref_title = f"{book['name']} {chapter_num}" + (f":{verse_range}" if verse_range else "")
    print(f"  {BOLD}{CYAN}📖  {ref_title}{RESET}  {DIM}(Nova Versão Internacional - NVI){RESET}")
    print("─" * term_width + "\n")

    audio_text_parts = []
    
    for i in range(v_start - 1, min(v_end, total_verses)):
        v_num = i + 1
        v_text = chapter_verses[i]
        audio_text_parts.append(f"Versículo {v_num}. {v_text}")
        
        # Formatação do versículo
        num_tag = f"{YELLOW}{BOLD}{v_num:2d}{RESET} "
        formatted_v = wrap_text(f"{num_tag} {v_text}", width=term_width - 4, indent="     ")
        print(f"  {formatted_v}\n")

    print("─" * term_width)

    if listen:
        full_audio_text = f"{book['name']}, capítulo {chapter_num}. " + " ".join(audio_text_parts)
        print(f"\n{BOLD}{GREEN}▶ Iniciando áudio neural ({rate})...{RESET} {DIM}[q para parar]{RESET}")
        play_audio(ref_title, full_audio_text, rate=rate)

def search_text(bible, query: str):
    """Busca termos na Bíblia inteira."""
    q_norm = normalize(query)
    matches = []
    for book in bible:
        for c_idx, chapter in enumerate(book["chapters"]):
            for v_idx, verse in enumerate(chapter):
                if q_norm in normalize(verse):
                    matches.append((book["name"], c_idx + 1, v_idx + 1, verse))

    print(f"\n{BOLD}{CYAN}🔍 Busca por:{RESET} \"{query}\"  {DIM}({len(matches)} ocorrências){RESET}\n")
    if not matches:
        print(f"  {YELLOW}Nenhum versículo encontrado.{RESET}\n")
        return

    for book_name, chap, ver, text in matches[:25]:
        print(f"  {BOLD}{YELLOW}{book_name} {chap}:{ver}{RESET}")
        print(f"    {DIM}{text}{RESET}\n")

    if len(matches) > 25:
        print(f"  {DIM}... e mais {len(matches) - 25} versículos encontrados.{RESET}\n")

def main():
    bible = load_bible()

    parser = argparse.ArgumentParser(
        description="Bíblia CLI / Leitor Zen Bimodal (NVI)",
        usage="biblia [livro] [capitulo] [versiculo] [-o] | biblia buscar <termo>"
    )
    parser.add_argument("args", nargs="*", help="Referência (ex: joao 3, romanos 8:28, sl 23)")
    parser.add_argument("-o", "--ouvir", "--listen", action="store_true", help="Ouvir capítulo/versículo com voz neural")
    parser.add_argument("-r", "--rate", default="+25%", help="Velocidade da narração (padrão: +25%%)")
    parser.add_argument("-b", "--buscar", "--search", help="Buscar texto em toda a Bíblia")
    parser.add_argument("--rofi", action="store_true", help="Abrir seletor interativo via Rofi")

    parsed = parser.parse_args()

    if parsed.buscar:
        search_text(bible, parsed.buscar)
        return

    if not parsed.args:
        # Se chamado sem argumentos e com --rofi
        if parsed.rofi or not sys.stdin.isatty():
            # Menu Rofi
            books_list = "\n".join(f"{b['name']} ({len(b['chapters'])} cap)" for b in bible)
            rofi_cmd = subprocess.run(["rofi", "-dmenu", "-p", "📖 Selecione o Livro"], input=books_list, text=True, stdout=subprocess.PIPE)
            selected = rofi_cmd.stdout.strip()
            if not selected:
                return
            book_name = selected.split(" (")[0]
            book = find_book(bible, book_name)
            if not book:
                return
            caps_list = "\n".join(f"Capítulo {i+1}" for i in range(len(book["chapters"])))
            c_cmd = subprocess.run(["rofi", "-dmenu", "-p", f"📖 {book['name']}: Capítulo"], input=caps_list, text=True, stdout=subprocess.PIPE)
            c_sel = c_cmd.stdout.strip()
            if not c_sel:
                return
            c_num = int(c_sel.replace("Capítulo ", ""))
            # Pergunta se quer ouvir
            act_cmd = subprocess.run(["rofi", "-dmenu", "-p", "Ação"], input="1. Ler na Janela\n2. Ouvir com Áudio Neural", text=True, stdout=subprocess.PIPE)
            listen = "Ouvir" in act_cmd.stdout
            if listen:
                show_chapter(bible, book, c_num, listen=True, rate=parsed.rate)
            else:
                subprocess.Popen(["ghostty", "-e", "bash", "-c", f"biblia {book['name']} {c_num}; read -n 1 -s -r -p 'Pressione qualquer tecla para fechar...'"])
            return

        # Modo de Ajuda e Exibição de Livros
        print(f"""
{BOLD}{CYAN}📖  BÍBLIA SAGRADA (NVI) - LEITOR ZEN & ÁUDIO BIMODAL{RESET}
{DIM}Uso prático:{RESET}
  {BOLD}biblia joao 3{RESET}             Lê o capítulo 3 de João no terminal
  {BOLD}biblia romanos 8 -o{RESET}       Lê o texto e inicia narração neural simultânea
  {BOLD}biblia sl 23{RESET}              Salmo 23 formatado em modo Zen
  {BOLD}biblia mt 5 1-12{RESET}          Mateus 5 (versículos 1 ao 12)
  {BOLD}biblia -b "amor de Deus"{RESET}  Busca versículos em toda a Bíblia
  {BOLD}biblia --rofi{RESET}             Menu gráfico para escolher Livro e Capítulo
""")
        return

    # Parse dos argumentos livres
    first_arg = parsed.args[0].lower()
    if first_arg in ["buscar", "find", "search"] and len(parsed.args) > 1:
        search_text(bible, " ".join(parsed.args[1:]))
        return

    # Tratamento de referências compostas:
    # Casos: "1", "corintios", "13" -> "1 corintios", 13
    # Casos: "romanos", "8", "28" -> "romanos", 8, "28"
    # Casos: "joao", "3:16" -> "joao", 3, "16"
    
    book_query = parsed.args[0]
    next_idx = 1
    if parsed.args[0] in ["1", "2", "3"] and len(parsed.args) > 1:
        book_query = f"{parsed.args[0]} {parsed.args[1]}"
        next_idx = 2

    book = find_book(bible, book_query)
    if not book:
        print(f"{YELLOW}Livro não reconhecido: '{book_query}'{RESET}")
        print("Exemplos: 'gn', 'genesis', 'sl', 'salmos', 'joao', 'rm', 'romanos'")
        return

    chap_num = 1
    verse_range = None

    if len(parsed.args) > next_idx:
        raw_chap = parsed.args[next_idx]
        if ":" in raw_chap:
            parts = raw_chap.split(":")
            chap_num = int(parts[0])
            verse_range = parts[1]
        else:
            chap_num = int(raw_chap)

    if len(parsed.args) > next_idx + 1:
        verse_range = parsed.args[next_idx + 1]

    show_chapter(bible, book, chap_num, verse_range=verse_range, listen=parsed.ouvir, rate=parsed.rate)

if __name__ == "__main__":
    main()
