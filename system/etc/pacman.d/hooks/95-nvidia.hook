[Trigger]
Operation=Install
Operation=Upgrade
Operation=Remove
Type=Package
Target=nvidia
Target=nvidia-open
Target=nvidia-dkms
Target=linux
Target=linux-cachyos
Target=linux-lts
Target=linux-zen

[Action]
Description=Garantindo sincronia de boot entre Kernel e driver NVIDIA (mkinitcpio)...
Depends=mkinitcpio
When=PostTransaction
Exec=/usr/bin/mkinitcpio -P
